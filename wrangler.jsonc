{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "asteroid-watch",
  "main": "./src/worker.js",
  "compatibility_date": "2026-10-17",
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true }
}
